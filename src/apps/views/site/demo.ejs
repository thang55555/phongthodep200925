            const clone = card.cloneNode(true);
            partnerSlider.appendChild(clone);
        });

        // Lấy chiều dài của một nửa danh sách
        function getPartnerSingleSetWidth() {
            return partnerSlider.scrollWidth / 2;
        }

        // Chuẩn hóa vị trí cuộn khi kéo chuột để tạo vòng tròn không giật
        function normalizePartnerScroll() {
            const singleWidth = getPartnerSingleSetWidth();
            if (partnerSlider.scrollLeft >= singleWidth) {
                partnerSlider.scrollLeft -= singleWidth;
            } else if (partnerSlider.scrollLeft <= 0) {
                partnerSlider.scrollLeft += singleWidth;
            }
        }

        // Tính năng Kéo chuột qua lại (Drag to scroll)
        let isPartnerDown = false;
        let partnerStartX;
        let partnerScrollLeft;

        partnerSlider.addEventListener('mousedown', (e) => {
            isPartnerDown = true;
            stopPartnerAutoScroll();
            partnerSlider.classList.add('dragging');
            partnerStartX = e.pageX - partnerSlider.offsetLeft;
            partnerScrollLeft = partnerSlider.scrollLeft;
        });

        partnerSlider.addEventListener('mouseleave', () => {
            isPartnerDown = false;
            partnerSlider.classList.remove('dragging');
            startPartnerAutoScroll();
        });

        partnerSlider.addEventListener('mouseup', () => {
            isPartnerDown = false;
            partnerSlider.classList.remove('dragging');
            startPartnerAutoScroll();
        });

        partnerSlider.addEventListener('mousemove', (e) => {
            if (!isPartnerDown) return;
            e.preventDefault();
            const x = e.pageX - partnerSlider.offsetLeft;
            const walk = (x - partnerStartX) * 1.5;
            partnerSlider.scrollLeft = partnerScrollLeft - walk;
            normalizePartnerScroll();
        });

        // --- TỰ ĐỘNG CHẠY VÒNG TRÒN KHÔNG GIẬT ---
        let partnerAutoScrollTimer;

        function startPartnerAutoScroll() {
            clearInterval(partnerAutoScrollTimer);

            partnerAutoScrollTimer = setInterval(() => {
                if (!isPartnerDown) {
                    partnerSlider.scrollLeft += 1;
                    const singleWidth = getPartnerSingleSetWidth();

                    // Khi chạy hết một vòng, tự động lùi lại để lặp tiếp vòng tròn vô tận
                    if (partnerSlider.scrollLeft >= singleWidth) {
                        partnerSlider.scrollLeft -= singleWidth;
                    }
                }
            }, 25); // Tốc độ chạy mượt mà
        }

        function stopPartnerAutoScroll() {
            clearInterval(partnerAutoScrollTimer);
        }

        // Tạm dừng khi rê chuột vào khung đối tác, chạy tiếp khi rời chuột
        partnerSlider.addEventListener('mouseenter', stopPartnerAutoScroll);

        // Khởi chạy ngay khi load trang
        startPartnerAutoScroll();
    </script>


