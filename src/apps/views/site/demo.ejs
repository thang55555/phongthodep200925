    }

    /* Hiển thị nút Tìm kiếm (Bên phải) */
    .search-btn {
        display: block !important;
        background: none;
        border: none;
        color: #dcdcdc;
        font-size: 16px;
        cursor: pointer;
        text-align: right;
        padding: 0;
    }

    /* 4. Biến menu chính thành dạng trượt từ bên trái sang */
    .nav-menu {
        position: fixed;
        top: 0;
        left: -100%; /* Ẩn sang bên trái màn hình */
        width: 280px;
        height: 100vh;
        background-color: #121212;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        padding: 60px 20px 30px 20px;
        gap: 0;
        box-shadow: 5px 0 25px rgba(0, 0, 0, 0.8);
        transition: left 0.35s ease-in-out;
        z-index: 100000;
        overflow-y: auto;
        max-width: 100%;
    }

    /* Class kích hoạt mở menu trên mobile */
    .nav-menu.active {
        left: 0;
    }

    /* Nút đóng menu (dấu X) */
    .mobile-close-btn {
        display: block;
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 22px;
        color: #d4af37;
        cursor: pointer;
    }

    .nav-menu > li {
        width: 100%;
        border-bottom: 1px solid #222;
        padding-bottom: 0;
        margin-bottom: 0;
    }

    .nav-menu > li > a,
    .menu-link-wrap > a {
        padding: 14px 0;
        font-size: 14px;
        display: block;
        width: 100%;
    }

    .nav-menu > li.active > a::after {
        display: none; /* Bỏ gạch chân trên mobile cho gọn */
    }

    /* Xử lý menu đa cấp trên mobile dạng bấm mở (accordion) thay vì hover */
    .menu-link-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .submenu-toggle-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: #d4af37;
        cursor: pointer;
        transition: transform 0.3s;
    }

    /* Ghi đè dropdown và submenu thành dạng danh sách dọc thụt lề */
    .dropdown, .submenu {
        position: static !important;
        opacity: 1 !important;
        visibility: visible !important;
        transform: none !important;
        box-shadow: none !important;
        background-color: #181818 !important;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-in-out;
        border-left: 2px solid #d4af37 !important;
        border-top: none !important;
        padding-left: 15px;
        width: 100%;
    }

    /* Khi mở menu con */
    .dropdown.open, .submenu.open {
        max-height: 500px; /* Đủ lớn để chứa các mục con */
    }
    
    .submenu-toggle-btn.rotated {
        transform: rotate(180deg);
    }

    .dropdown li a, .submenu li a {
        padding: 10px 0;
        font-size: 13px;
        color: #aaa;
    }
}
/* Đảm bảo khi header chuyển sang trạng thái cố định (is-sticky) trên mobile, các thành phần con vẫn hiển thị đầy đủ */
@media (max-width: 1024px) {
    .header-fixed-wrapper.is-sticky {
        position: fixed !important;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 99999;
        background-color: rgba(18, 18, 18, 0.98) !important; /* Giữ nền tối rõ nét khi cuộn */
    }

    /* Đảm bảo nút tìm kiếm luôn hiển thị và không bị mất chỗ trên lưới mobile */
    .header-fixed-wrapper.is-sticky .search-btn {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }
}
</style>

<script>
    // Bật/tắt menu chính khi bấm nút hamburger hoặc dấu X
    const menuToggle = document.getElementById('menuToggle');
    const menuClose = document.getElementById('menuClose');
    const navMenu = document.getElementById('navMenu');

    if (menuToggle && navMenu) {
        menuToggle.addEventListener('click', function() {
            navMenu.classList.add('active');
        });
    }

    if (menuClose && navMenu) {
        menuClose.addEventListener('click', function() {
            navMenu.classList.remove('active');
        });
    }

    // Xử lý bấm vào dấu mũi tên để mở menu đa cấp (Dropdown & Submenu) trên mobile
    const toggleBtns = document.querySelectorAll('.submenu-toggle-btn');
    toggleBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            // Tìm cấp menu con ngay bên cạnh
            const parentLi = this.closest('li');
            const sub = parentLi.querySelector('.dropdown, .submenu');
            
            if (sub) {
                sub.classList.toggle('open');
                this.classList.toggle('rotated');
            }
        });
    });
</script>









