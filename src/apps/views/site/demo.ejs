    }

    .mobile-logo .logo-img {
        max-height: 38px;
        width: auto;
    }

    /* 3. Tùy chỉnh thanh menu chính thành 3 cột trên 1 hàng: [Hamburger] [Logo] [Tìm kiếm] */
    .main-header-wrapper {
        padding: 8px 0;
        background-color: #121212;
    }

    .main-header {
        display: grid;
        grid-template-columns: 40px 1fr 40px;
        align-items: center;
        justify-content: space-between;
        padding: 0 15px;
    }

    /* Hiển thị nút Hamburger (Bên trái) */
    .mobile-menu-toggle {
        display: block;
        background: none;
        border: none;
        color: #d4af37;
        font-size: 20px;
        cursor: pointer;
        text-align: left;
