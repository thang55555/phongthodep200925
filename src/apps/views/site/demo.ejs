            height: 38px;
            border-radius: 50%;
            background-color: rgba(20, 18, 16, 0.9);
            border: 1px solid var(--gold-color);
            color: var(--gold-color);
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: background-color 0.3s, color 0.3s;
        }

        .slider-btn:hover {
            background-color: var(--gold-color);
            color: var(--dark-bg);
        }

        .prev-btn {
            left: -20px;
        }

        .next-btn {
            right: -20px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .product-card {
                flex: 0 0 200px;
            }

            .prev-btn {
                left: -10px;
            }

            .next-btn {
                right: -10px;
            }
        }
    </style>

    <script>
        const slider = document.querySelector('.products-slider');
        const prevBtn = document.querySelector('.prev-btn');
        const nextBtn = document.querySelector('.next-btn');

        // Khoảng cách trượt mỗi khi bấm nút (độ rộng của 1 card + khoảng cách gap)
        const scrollAmount = 250;

        // Sự kiện bấm nút mũi tên phải
        nextBtn.addEventListener('click', () => {
            slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });

        // Sự kiện bấm nút mũi tên trái
        prevBtn.addEventListener('click', () => {
            slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });

        // Tính năng Dê chuột kéo qua lại (Drag to scroll)
        let isDown = false;
        let startX;
        let scrollLeft;

        slider.addEventListener('mousedown', (e) => {
            isDown = true;
            slider.classList.add('dragging');
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
        });

        slider.addEventListener('mouseleave', () => {
            isDown = false;
            slider.classList.remove('dragging');
        });

        slider.addEventListener('mouseup', () => {
            isDown = false;
            slider.classList.remove('dragging');
        });

        slider.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 1.5; // Tốc độ kéo chuột
            slider.scrollLeft = scrollLeft - walk;
        });
    </script>

