.header-fixed-wrapper {
    position: relative; /* Ban đầu nằm bình thường theo luồng trang */
    top: 0;
    left: 0;
    width: 100%;
    z-index: 99999;
    background-color: rgba(11, 11, 11, 0.95);
    transition: background-color 0.3s ease;
}

/* Khi cuộn qua vị trí kích hoạt, chuyển sang cố định và có bóng đổ */
.header-fixed-wrapper.is-sticky {
    position: fixed;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(10px);
}

    </style>

<script>
    window.addEventListener('scroll', function() {
        const header = document.getElementById('headerSticky');
        // 120px là chiều cao ước tính của header, bạn có thể chỉnh lại số này cho khớp thực tế
        if (window.scrollY > 120) {
            header.classList.add('is-sticky');
        } else {
            header.classList.remove('is-sticky');
        }
    });
</script>


<!-- menu mobile -->

<style>
/* Mặc định trên máy tính ẩn nút hamburger, nút đóng menu mobile và nút mũi tên đa cấp mobile */
.mobile-menu-toggle,
