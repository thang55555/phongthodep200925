    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tSlides = document.querySelectorAll(".testimonial-item");
            const tDots = document.querySelectorAll(".testimonial-dots .dot");
            let tCurrentIndex = 0;
            let tInterval;

            function showTestimonial(index) {
                tSlides.forEach((slide) => slide.classList.remove("active"));
                tDots.forEach((dot) => dot.classList.remove("active"));

                if (tSlides[index] && tDots[index]) {
                    tSlides[index].classList.add("active");
                    tDots[index].classList.add("active");
                }
                tCurrentIndex = index;
            }

            function nextTestimonial() {
                let nextIndex = (tCurrentIndex + 1) % tSlides.length;
                showTestimonial(nextIndex);
            }

            function startTestimonialTimer() {
                if (tInterval) clearInterval(tInterval);
                // Đặt thời gian chuyển (ví dụ 1000ms = 1 giây)
                tInterval = setInterval(nextTestimonial, 1000);
            }

            function stopTestimonialTimer() {
                clearInterval(tInterval);
            }

            // Bấm trực tiếp vào dot để đổi slide
            tDots.forEach((dot) => {
                dot.addEventListener("click", function () {
                    stopTestimonialTimer();
                    let index = parseInt(this.getAttribute("data-index"));
                    showTestimonial(index);
                    startTestimonialTimer();
                });
            });

            // Tạm dừng khi rê chuột vào
            const testimonialBox = document.querySelector(".testimonial-box");
            if (testimonialBox) {
                testimonialBox.addEventListener("mouseenter", stopTestimonialTimer);
                testimonialBox.addEventListener("mouseleave", startTestimonialTimer);
            }

            // --- SỬA Ở ĐÂY ĐỂ KHÔNG BỊ ĐƠ KHI LOAD XONG ---
            // Gọi ngay lập tức slide đầu tiên và bắt đầu bộ đếm chuyển sang slide thứ 2 luôn
            showTestimonial(0);
            startTestimonialTimer();
        });
    </script>

