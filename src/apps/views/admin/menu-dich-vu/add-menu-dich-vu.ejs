<%- include("../layout/head", {title: "Admin thêm mới menu dịch vụ" })%>
    <%- include("../layout/header")%>
        <%- include("../layout/siderbar")%>


            <div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
                <div class="row">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard"><svg class="glyph stroked home">
                                    <use xlink:href="#stroked-home"></use>
                                </svg></a></li>
                        <li><a href="/admin/menu-dich-vu">Menu dịch vụ</a></li>
                        <li>Thêm menu dịch vụ</li>
                    </ol>
                </div><!--/.row-->

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">Thêm menu dịch vụ</h1>
                    </div>
                </div><!--/.row-->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <div class="col-md-8">
                                    <div class="<%=data.error? " alert alert-danger" : "" %>" ><%=data.error%>
                                    </div>
                                    <form name="frm" role="form" method="post" action="/admin/upload-menu-dich-vu"
                                        enctype="multipart/form-data">
                                        <div class="form-group">
                                            <label>Tên menu dịch vụ:</label>
                                            <input required type="text" name="menudichvu" class="form-control"
                                                placeholder="Tên menu dịch vụ...">
                                        </div>
                                        <div class="form-group">
                                            <div class="form-group">
                                                <label>Chọn nơi hiển thị (giữ phím Ctrl để chọn nhiều):</label>
                                                <select required name="web" class="form-control" multiple>
                                                    <option value="Phongthodep.net">Phongthodep.net</option>
                                                    <option value="Nhagonamthanhphat.com">Nhagonamthanhphat.com</option>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- 3 thẻ sale -->
<div class="form-group">
    <label>Thẻ title <span id="label_title"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)" 
           name="title" type="text" class="form-control" placeholder="Title">
    
    <div class="progress-container">
        <div id="bar_title" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta description <span id="label_meta"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)" 
           name="metadescription" type="text" class="form-control" placeholder="Meta description...">
    
    <div class="progress-container">
        <div id="bar_meta" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta keywords <span id="label_keywords"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)" 
           name="metakeywords" type="text" class="form-control" placeholder="Meta keywords...">
    
    <div class="progress-container">
        <div id="bar_keywords" class="progress-bar"></div>
    </div>
</div>
                                        <div class="form-group">
                                            <input name="images" type="file" required>
                                            <br>
                                        </div>
                                        <div class="form-group">
                                            <label>Mô tả menu dịch vụ</label>
                                            <textarea id="description" required name="content" class="form-control"
                                                rows="3"></textarea>
                                            <script>
                                                CKEDITOR.replace('description', {
                                                    extraPlugins: 'filebrowser',
                                                    filebrowserBrowseUrl: '/list',//upload location
                                                    filebrowserUploadMethod: 'form',
                                                    filebrowserUploadUrl: '/upload'//route
                                                });
                                            </script>
                                        </div>



                                        <button type="submit" name="sbm" class="btn btn-success">Thêm mới</button>
                                        <button type="reset" class="btn btn-default">Làm mới</button>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div><!-- /.col-->
            </div> <!--/.main-->

            <script src="js/jquery-1.11.1.min.js"></script>
            <script src="js/bootstrap.min.js"></script>
            <script src="js/bootstrap-table.js"></script>

            <%- include("../layout/footer")%>