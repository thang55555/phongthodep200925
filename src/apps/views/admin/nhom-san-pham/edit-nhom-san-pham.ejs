
<%- include("../layout/head", {title: "Admin update menu sản phẩm"})%>
<%- include("../layout/header")%>
<%- include("../layout/siderbar")%>


	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
		<div class="row">
			<ol class="breadcrumb">
				<li><a href="/admin/dashboard"><svg class="glyph stroked home">
							<use xlink:href="#stroked-home"></use>
						</svg></a></li>
				<li><a href="/admin/nhom-san-pham">Menu sản phẩm</a></li>
	 			<li>update menu sản phẩm</li>
			</ol>
		</div><!--/.row-->

		<div class="row">
			<div class="col-lg-12">
				<h1 class="page-header">Menu sản phẩm: <%=editnhom.tennhomsanpham%></h1>
			</div>
		</div><!--/.row-->
		<div class="row">
			<div class="col-lg-12">
				<div class="panel panel-default">
					<div class="panel-body">
						<div class="col-md-6">
							<form name="frm" role="form" method="post" action="/admin/update-nhom-san-pham/<%=editnhom._id%>" enctype="multipart/form-data">
								<div class="form-group">
									<label>Tên menu sản phẩm:</label>
									<input required type="text" name="tennhomsanpham" class="form-control" value="<%=editnhom.tennhomsanpham%>"
										placeholder="Tên nhóm sản phẩm...">
								</div>
								<div class="form-group">
									<label>Menu Danh mục</label>
									<select name="danhmuc_id" class="form-control">
										<% for(item of danhmuc){%>
										<option <%= editnhom.danhmuc_id==item.id && "selected" %> value="<%=item._id%>"> <%=item.tendanhmuc%></option>
										<%}%>
									</select>
								</div>

								                                           <div class="form-group">
    <label>Chọn nơi hiển thị (giữ phím Ctrl để chọn nhiều):</label>
    <select name="web" class="form-control" multiple>
        <% 
        // Lấy mảng web từ database, nếu không có thì mặc định là mảng rỗng
        const currentWebs = editnhom.web || []; 
        %>
        
        <option value="Phongthodep.net" <%= currentWebs.includes('Phongthodep.net') ? 'selected' : '' %>>
            Phongthodep.net
        </option>
        
        <option value="Nhagonamthanhphat.com" <%= currentWebs.includes('Nhagonamthanhphat.com') ? 'selected' : '' %>>
            Nhagonamthanhphat.com
        </option>
    </select>
</div>


<div class="form-group">
    <label>Thẻ title <span id="label_title"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_title', 'label_title', 50, 60)" 
           name="title" type="text" class="form-control" placeholder="Title" value="<%=editnhom.title%>">
    
    <div class="progress-container">
        <div id="bar_title" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta description <span id="label_meta"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_meta', 'label_meta', 140, 160)" 
           name="metadescription" type="text" class="form-control" placeholder="Meta description..." value="<%=editnhom.metadescription%>">
    
    <div class="progress-container">
        <div id="bar_meta" class="progress-bar"></div>
    </div>
</div>


<div class="form-group">
    <label>Thẻ meta keywords <span id="label_keywords"></span></label>
    <input required onkeyup="updateAll(this.value, 'bar_keywords', 'label_keywords', 100, 200)" 
           name="metakeywords" type="text" class="form-control" placeholder="Meta keywords..." value="<%=editnhom.metakeywords%>" >
    
    <div class="progress-container">
        <div id="bar_keywords" class="progress-bar"></div>
    </div>
</div>

						</div>
						<div class="col-md-6">
							
							<div class="form-group">
								<label>Quy trình dịch vụ</label>
								<textarea id="description" required name="quytrinh" class="form-control" value="" rows="3"><%=editnhom.quytrinh%></textarea>
								<script>
									CKEDITOR.replace('description',{
                                            extraPlugins:'filebrowser',
                                            filebrowserBrowseUrl:'/list',//upload location
                                            filebrowserUploadMethod:'form',
                                            filebrowserUploadUrl:'/upload'//route
                                        });
								</script>
							</div>

							<button type="submit" name="sbm" class="btn btn-success">Update</button>
							<button type="reset" class="btn btn-default">Làm mới</button>
						</div>

						</form>
					</div>
				</div>
			</div>
		</div><!-- /.col-->
	</div> <!--/.main-->

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
	<script src="js/bootstrap-table.js"></script>

	<%- include("../layout/footer")%>